[push]
	default = current
[pull]
        rebase = false
[alias]
	st = status
	ci = commit
	ca = commit --amend
	co = checkout
	br = branch
	cp = cherry-pick
	bc = "!git branch --show-current | tr -d '\n' | pbcopy"
	by = bc
	vi = "!nvim -c 'G'"
	last = log -1
	unstage = reset HEAD --
	tree = log --all --graph --decorate --oneline
	hist = log --pretty=format:'%h %ad | %s%d [%an]' --graph --date=short
	mv = "!f(){ git branch -m $1 $2; if [[ `git ls-remote --heads origin $1 | wc -l` -eq 1 ]]; then git push origin :$1; git push origin $2; fi };f"
	pr = "!f(){ git fetch origin pull/$1/head:pr-$1 && git checkout pr-$1; };f"
	fd = "!f(){ git branch -a | grep -v remotes | grep $1 | head -n 1 | xargs git checkout; };f"
	clear = "!clear; echo \"Good job.\""
	yeet = !git add . && git commit
	yt = yeet
	yolo = "!git add . && git commit -m \"$(curl -s https://whatthecommit.com/index.txt) -yolo\"  && git push origin HEAD -f"
	yoink = "!git pull origin $(git branch --show-current | tr -d '\n')"
	yk = yoink
	rent = "!git pull origin $(git branch -l master main | sed 's/^* //')"
	cull = "!git for-each-ref --format '%(refname:short)' refs/heads | grep -v 'master\\|main' | xargs git branch -D"
	ticket = "!~/workspace/ticket.sh"
	tk = ticket
[core]
	execludesfile = ~/.gitignore
	autocrlf = input
	pager = less -FMRiX
	editor = nvim
[fetch]
	prune = true
[user]
	email = mmanning2@chewy.com
	name = Michael Manning
[url "ssh://git@github"]
	insteradOf = https://github.com
[github]
	user = mmanning2-chwy
[init]
	defaultBranch = dev

